" ============================================================================
" IdeaVim — LazyVim-faithful config for WebStorm / IntelliJ IDEs
" ============================================================================
" Goal: mirror Mike's stock LazyVim keymaps (~/.config/lazyvim) as closely as
" JetBrains actions allow. Source of truth: LazyVim's installed source at
" ~/.local/share/lazyvim/lazy/LazyVim/lua/lazyvim/*.
"
" REQUIRES these IDE plugins (Settings -> Plugins):
"   - IdeaVim, Which-Key, AceJump, IdeaVim-EasyMotion (EasyMotion needs AceJump)
"
" Known gaps vs. LazyVim (no clean JetBrains analog):
"   - mini.surround verbs: LazyVim uses gsa/gsd/gsr; here `set surround` gives
"     classic ys/cs/ds/S. Same engine, different verbs.
"   - mini.files: no floating path-editable file manager; <leader>e/E/fm map to
"     the Project tool window (reveal / activate).
"   - flash S (treesitter), codelens, relnum/spell toggles, per-hunk staging
"     (IDE stages per file), yanky cycle-after-paste, LazyVim-only pickers.
"   - clipboard kept separate (Mike's choice), so <leader>p (paste history)
"     shows IDE-copied items, not vim-yanked ones.
" ============================================================================

" ----------------------------------------------------------------------------
" Settings
" ----------------------------------------------------------------------------
set scrolloff=4
set sidescrolloff=8
set number relativenumber
set incsearch hlsearch
set ignorecase smartcase
set showmode
set clipboard=                 " keep vim registers separate from macOS clipboard
set ideajoin                   " use IDE's smart join for J
set ideamarks                  " sync vim marks <-> IDE bookmarks
set idearefactormode=keep      " keep vim mode during IDE refactors
set ideastatusicon=gray
set timeout timeoutlen=500     " which-key pops after 0.5s; keeps jk snappy

" ----------------------------------------------------------------------------
" Plugin emulation (matches LazyVim behavior)
" ----------------------------------------------------------------------------
set surround                   " ys/cs/ds/S  (engine for surrounds)
set commentary                 " gcc / gc{motion}  == LazyVim gc
set argtextobj                 " ia / aa      == mini.ai args
set textobj-entire             " ae / ie      entire buffer
set highlightedyank            " == vim.highlight.on_yank
set which-key                  " keybinding hint popups
set easymotion                 " flash-style jump (needs AceJump)

let mapleader = " "
let maplocalleader = " "

" ----------------------------------------------------------------------------
" Which-Key group labels (mirror LazyVim's groups)
" ----------------------------------------------------------------------------
let g:WhichKey_FontSize = 16
let g:WhichKey_SortOrder = "by_key_prefix_first"

let g:WhichKeyDesc_file    = "<leader>f file/find"
let g:WhichKeyDesc_search  = "<leader>s search"
let g:WhichKeyDesc_code    = "<leader>c code"
let g:WhichKeyDesc_git     = "<leader>g git"
let g:WhichKeyDesc_hunks   = "<leader>gh hunks"
let g:WhichKeyDesc_ui      = "<leader>u ui"
let g:WhichKeyDesc_diag    = "<leader>x diagnostics/quickfix"
let g:WhichKeyDesc_buffer  = "<leader>b buffer"
let g:WhichKeyDesc_window  = "<leader>w window"
let g:WhichKeyDesc_quit    = "<leader>q quit"
let g:WhichKeyDesc_test    = "<leader>t test"
let g:WhichKeyDesc_debug   = "<leader>d debug"
let g:WhichKeyDesc_tabs    = "<leader><tab> tabs"

" ----------------------------------------------------------------------------
" Flash (jump) via EasyMotion  —  LazyVim binds s/S to flash
" ----------------------------------------------------------------------------
map s <Plug>(easymotion-s2)    " type 2 chars -> labels -> jump

" ----------------------------------------------------------------------------
" Motions / windows / editing  (config/keymaps.lua)
" ----------------------------------------------------------------------------
" Window navigation across editor splits
nmap <C-h> <C-w>h
nmap <C-j> <C-w>j
nmap <C-k> <C-w>k
nmap <C-l> <C-w>l

" Move lines up/down
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)
imap <A-j> <Action>(MoveLineDown)
imap <A-k> <Action>(MoveLineUp)

" Buffers == editor tabs
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)
nmap [b <Action>(PreviousTab)
nmap ]b <Action>(NextTab)

" Keep selection while indenting
vnoremap < <gv
vnoremap > >gv

" Save
map <C-s> <Action>(SaveAll)

" Clear search highlight on Esc (LazyVim maps Esc -> noh)
nnoremap <Esc> :nohlsearch<CR><Esc>

" Terminal
map <C-/> <Action>(ActivateTerminalToolWindow)

" ----------------------------------------------------------------------------
" LSP goto + hover + signature  (plugins/lsp/init.lua)
" ----------------------------------------------------------------------------
nmap gd <Action>(GotoDeclaration)          " Goto Definition
nmap gy <Action>(GotoTypeDeclaration)      " Goto Type Definition
nmap gI <Action>(GotoImplementation)       " Goto Implementation
nmap gr <Action>(ShowUsages)               " References
nmap gD <Action>(GotoDeclaration)          " (IDE conflates decl/def)
nmap K  <Action>(QuickJavaDoc)             " Hover
nmap gK <Action>(ParameterInfo)            " Signature Help
imap <C-k> <Action>(ParameterInfo)

" Next/prev reference (document highlight)
nmap ]] <Action>(GotoNextElementUnderCaretUsage)
nmap [[ <Action>(GotoPrevElementUnderCaretUsage)
nmap <A-n> <Action>(GotoNextElementUnderCaretUsage)
nmap <A-p> <Action>(GotoPrevElementUnderCaretUsage)

" Diagnostics navigation (IDE nav covers errors + warnings)
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)
nmap ]e <Action>(GotoNextError)
nmap [e <Action>(GotoPreviousError)
nmap ]w <Action>(GotoNextError)
nmap [w <Action>(GotoPreviousError)

