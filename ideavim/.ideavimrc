" ========================================
" IdeaVim Configuration for IntelliJ IDEs
" ========================================
" Author: Unified config combining best practices
" Last Updated: 2025

" ========================================
" Basic Settings
" ========================================

set ideajoin                " Use IDE's join/J command
set ideastatusicon=gray     " Gray icon in status bar
set idearefactormode=keep   " Keep mode during refactoring
set ideamarks               " Sync marks with IDE bookmarks
" set clipboard+=unnamed      " System clipboard integration
" set clipboard+=ideaput      " IDE paste integration
set clipboard=              " Keep vim separate from system clipboard

" Common Vim settings
set number relativenumber   " Hybrid line numbers
set incsearch hlsearch      " Incremental and highlighted search
set ignorecase smartcase    " Smart case searching
set scrolloff=5             " Keep 5 lines visible when scrolling
set showmode                " Show current mode
set showcmd                 " Show command in status line
set visualbell              " Visual bell instead of beeping

" ========================================
" Plugin Emulation
" ========================================

set surround                " vim-surround emulation (cs'", ysiw], etc)
set commentary              " vim-commentary emulation (gcc, gc)
set argtextobj              " Argument text objects (via, cia, daa)
set textobj-entire          " Entire buffer text objects (vae, dae)
set ReplaceWithRegister     " Replace with register (gr)
set exchange                " Exchange text (cx)
set highlightedyank         " Highlight yanked text briefly
set NERDTree                " NERDTree emulation
set which-key               " Which-key emulation for keybind hints
set notimeout               " Disable timeout for which-key

" ========================================
" Which-Key Configuration
" ========================================

let g:WhichKey_FontSize = 16
let g:WhichKey_CommandColor = "#41ead4"
let g:WhichKey_PrefixColor = "#f335b2"
let g:WhichKey_SortOrder = "by_key_prefix_first"

let g:WhichKeyDesc_leader = "<leader> Leader key"

" ========================================
" Leader Keys
" ========================================

let mapleader = " "
let maplocalleader = " "

" ========================================
" Insert Mode Mappings
" ========================================

" Quick escape
inoremap jk <Esc>
inoremap jj <Esc>

" Popup menu navigation
inoremap <C-j> <Action>(EditorChooseLookupItemDown)
inoremap <C-k> <Action>(EditorChooseLookupItemUp)

" ========================================
" Split Navigation (Vim/Tmux style)
" ========================================

" Navigate between splits with Ctrl+hjkl
nmap <C-h> <C-w>h
nmap <C-l> <C-w>l
nmap <C-k> <C-w>k
nmap <C-j> <C-w>j

" ========================================
" Window/Split Management
" ========================================

let g:WhichKeyDesc_window = "<leader>w Window/Split"
nmap <leader>wv <Action>(SplitVertically)
let g:WhichKeyDesc_window_vertical = "<leader>wv Split vertical"
nmap <leader>ws <Action>(SplitHorizontally)
let g:WhichKeyDesc_window_horizontal = "<leader>ws Split horizontal"
nmap <leader>wo <Action>(UnsplitAll)
let g:WhichKeyDesc_window_close_all = "<leader>wo Close all splits"
nmap <leader>wO <Action>(MoveEditorToOppositeTabGroup)
let g:WhichKeyDesc_window_move = "<leader>wO Move to opposite group"
nmap <leader>wd <Action>(CloseContent)
let g:WhichKeyDesc_window_delete = "<leader>wd Delete window"

" Window sizing
nmap <leader>wh <Action>(StretchSplitToLeft)
nmap <leader>wl <Action>(StretchSplitToRight)
nmap <leader>wk <Action>(StretchSplitToTop)
nmap <leader>wj <Action>(StretchSplitToBottom)
nmap <leader>wm <Action>(MaximizeEditorInSplit)
nmap <leader>we <Action>(HideAllWindows)

" ========================================
" Tab Navigation
" ========================================

" Quick tab navigation with Alt (both styles for convenience)
nmap <A-n> <Action>(NextTab)
nmap <A-p> <Action>(PreviousTab)

" Leader-based tab navigation
let g:WhichKeyDesc_tab = "<leader>T Tab"
nmap <leader>Tn <Action>(NextTab)
let g:WhichKeyDesc_tab_next = "<leader>Tn Next tab"
nmap <leader>Tp <Action>(PreviousTab)
let g:WhichKeyDesc_tab_prev = "<leader>Tp Previous tab"
nmap <leader>Tc <Action>(CloseEditor)
let g:WhichKeyDesc_tab_close = "<leader>Tc Close tab"
nmap <leader>To <Action>(CloseAllEditorsButActive)
let g:WhichKeyDesc_tab_only = "<leader>To Close other tabs"

" ========================================
" Search & Navigation
" ========================================

let g:WhichKeyDesc_search = "<leader>s Search"
nmap <leader>sf <Action>(GotoFile)
let g:WhichKeyDesc_search_files = "<leader>sf Search files"
nmap <leader>sr <Action>(RecentFiles)
let g:WhichKeyDesc_search_recent = "<leader>sr Recent files"
nmap <leader>sc <Action>(RecentChangedFiles)
let g:WhichKeyDesc_search_changed = "<leader>sc Recently changed"
nmap <leader>sl <Action>(RecentLocations)
let g:WhichKeyDesc_search_locations = "<leader>sl Recent locations"
nmap <leader>ss <Action>(GotoSymbol)
let g:WhichKeyDesc_search_symbols = "<leader>ss Search symbols"
nmap <leader>sa <Action>(GotoAction)
let g:WhichKeyDesc_search_actions = "<leader>sa Search actions"
nmap <leader>sg <Action>(FindInPath)
let g:WhichKeyDesc_search_grep = "<leader>sg Grep in project"
nmap <leader>su <Action>(FindUsages)
let g:WhichKeyDesc_search_usages = "<leader>su Search usages"

" Quick access to recent files
nmap <leader><leader> <Action>(RecentFiles)

" Close content
nmap <leader>q <Action>(CloseContent)

" ========================================
" Project Explorer (NERDTree-like)
" ========================================

let g:WhichKeyDesc_explorer = "<leader>e Explorer"
nmap <leader>e :NERDTreeToggle<CR>
let g:WhichKeyDesc_explorer_toggle = "<leader>e Toggle explorer"
nmap <leader>ef :NERDTreeFind<CR>
let g:WhichKeyDesc_explorer_find = "<leader>ef Find in explorer"
nmap <leader>ep <Action>(ActivateProjectToolWindow)
let g:WhichKeyDesc_explorer_project = "<leader>ep Project tool window"
nmap <leader>es <Action>(ActivateStructureToolWindow)
let g:WhichKeyDesc_explorer_structure = "<leader>es Structure tool window"

" ========================================
" Code Navigation (Semantic)
" ========================================

" Method/function navigation with [[ and ]]
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" Diagnostic navigation (errors, warnings, hints)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
nmap [e <Action>(GotoPreviousError)
nmap ]e <Action>(GotoNextError)
nmap [w <Action>(GotoPreviousError)
nmap ]w <Action>(GotoNextError)

" Git change markers
nmap [c <Action>(VcsShowPrevChangeMarker)
nmap ]c <Action>(VcsShowNextChangeMarker)
nmap [g <Action>(VcsShowPrevChangeMarker)
nmap ]g <Action>(VcsShowNextChangeMarker)

" Test navigation
nmap ]t <Action>(GotoTest)

" Show problems panel
nmap <leader>ep <Action>(ActivateProblemsViewToolWindow)

" ========================================
" Go To Navigation (LSP-like)
" ========================================

let g:WhichKeyDesc_goto = "<leader>g Go to"
nmap gd <Action>(GotoDeclaration)
nmap gD <Action>(GotoTypeDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(ShowUsages)
nmap gs <Action>(GotoSuperMethod)
nmap gt <Action>(GotoTest)
nmap go <Action>(GotoRelated)

" Navigate back/forward in history
nmap gb <Action>(Back)
nmap gf <Action>(Forward)

" ========================================
" Terminal
