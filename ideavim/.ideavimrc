" ========================================
" Search & Replace
" ========================================

" Clear search highlighting
nmap <leader>nh :nohlsearch<CR>

" Search operations
nmap <leader>/ <Action>(Find)
nmap <leader>? <Action>(FindInPath)
nmap <leader>* <Action>(FindWordAtCaret)

" Replace (matches nvim <leader>r namespace)
nmap <leader>rr <Action>(Replace)
nmap <leader>rR <Action>(ReplaceInPath)

" ========================================
" Folding
" ========================================

nmap zc <Action>(CollapseRegion)
nmap zo <Action>(ExpandRegion)
nmap zC <Action>(CollapseRegionRecursively)
nmap zO <Action>(ExpandRegionRecursively)
nmap za <Action>(ExpandCollapseToggleAction)
nmap zR <Action>(ExpandAllRegions)
nmap zM <Action>(CollapseAllRegions)

" Leader-based folding
nmap <leader>zc <Action>(CollapseAllRegions)
nmap <leader>zo <Action>(ExpandAllRegions)

" ========================================
" Multiple Cursors
" ========================================

nmap <C-n> <Action>(SelectNextOccurrence)
nmap <C-p> <Action>(UnselectPreviousOccurrence)
nmap <C-S-n> <Action>(SelectAllOccurrences)

" ========================================
" Productivity Enhancements
" ========================================

" Zen mode / Distraction free
nmap <leader>z <Action>(ToggleDistractionFreeMode)

" Context actions
nmap <leader>mm <Action>(ShowPopupMenu)
nmap <leader>mp <Action>(ManageRecentProjects)

" Quick save/quit
nmap <leader>w :w<CR>
nmap <leader>x :x<CR>

" ========================================
" Visual Mode Enhancements
" ========================================

" Keep selection when indenting
vnoremap < <gv
vnoremap > >gv

" Move lines up/down with Alt+j/k
nmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
vmap <A-j> <Action>(MoveLineDown)
vmap <A-k> <Action>(MoveLineUp)

" ========================================
" Quality of Life Improvements
" ========================================

" Don't yank on delete with x
nnoremap x "_x
vnoremap x "_x

" Don't yank on paste in visual mode
vnoremap p "_dP

" Center screen after navigation
nmap <C-d> <C-d>zz
nmap <C-u> <C-u>zz
nmap n nzzzv
nmap N Nzzzv
nmap * *zz
nmap # #zz
nmap g* g*zz
nmap g# g#zz

" Y yanks to end of line (like D and C)
nmap Y y$

" ========================================
" Miscellaneous
" ========================================

" Toggle soft wraps (ui namespace)
nmap <leader>uw <Action>(ToggleUseSoftWraps)

" Show all current mappings
nmap <leader>? :map<CR>

